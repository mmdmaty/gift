# Copy to .env for local development:  cp .env.example .env
# On a server, deploy/install.sh writes these to /etc/raha_gift/raha_gift.env for you.

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 1 = development (debug pages, Django serves static/media), 0 = production
DJANGO_DEBUG=1

# Extra hostnames, comma separated (localhost/127.0.0.1 are always allowed)
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Full origins allowed to POST forms, comma separated
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# 1 = site is served over HTTPS (cookies are sent only over HTTPS)
DJANGO_HTTPS=0

# 1 = only if the site sits behind the Cloudflare proxy (trust CF-Connecting-IP for the login ban)
LOGIN_TRUST_CLOUDFLARE_IP=0
